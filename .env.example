# =============================================================================
# Terminal Agent — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API Keys (Set the API key for the provider(s) you use)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# NVIDIA_API_KEY=nvapi-...
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# 2. Active Model Profile
# Select which model profile to launch by default.
# Built-in presets:
#   - sonnet            : Anthropic Claude Sonnet 4 (Default)
#   - haiku             : Anthropic Claude 3.5 Haiku
#   - nemotron          : NVIDIA NIM Nemotron-3 Ultra 550B
#   - gpt4o             : OpenAI GPT-4o
#   - gpt4o-mini        : OpenAI GPT-4o Mini
#   - deepseek          : OpenRouter DeepSeek V3
#   - deepseek-r1       : OpenRouter DeepSeek R1
#   - openrouter-claude : OpenRouter Claude 3.5 Sonnet
#   - llama             : OpenRouter Meta Llama 3.3 70B
# -----------------------------------------------------------------------------
AGENT_PROFILE=sonnet

# -----------------------------------------------------------------------------
# 3. Optional Settings & Overrides
# -----------------------------------------------------------------------------
# AGENT_BASE_URL=http://localhost:11434/v1   # Optional: Custom endpoint for local LLMs/proxies
# AGENT_PERMISSION_MODE=safe                 # safe | auto-test | yolo
# AGENT_MAX_ITERATIONS=25                    # Maximum tool execution loops per turn
# AGENT_MAX_CONTEXT_TOKENS=100000            # Context window budget before truncation
