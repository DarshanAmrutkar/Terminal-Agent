# =============================================================================
# Terminal Agent — Complete Environment Configuration Template (.env)
# =============================================================================
# Copy this file to '.env' and fill in your keys and preferences.
#
# Variables are loaded by Pydantic:
#   - API keys use standard uppercase names (e.g., ANTHROPIC_API_KEY).
#   - All other agent settings use the 'AGENT_' prefix (e.g., AGENT_PROFILE).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API Keys (Set the key for the provider(s) you intend to use)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=AIzaSy...
# NVIDIA_API_KEY=nvapi-...
# OPENROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# 2. Active Model Profile Preset
# -----------------------------------------------------------------------------
# Setting AGENT_PROFILE configures provider, model, context window, and token
# limits in one shot. Leave empty or commented to use manual overrides below.
#
# Available Built-in Presets:
#   - sonnet            : Anthropic Claude Sonnet 4 (Default)
#   - haiku             : Anthropic Claude 3.5 Haiku
#   - nemotron          : NVIDIA NIM Nemotron-3 Ultra 550B
#   - gpt4o             : OpenAI GPT-4o
#   - gpt4o-mini        : OpenAI GPT-4o Mini
#   - deepseek          : OpenRouter DeepSeek V3
#   - deepseek-r1       : OpenRouter DeepSeek R1
#   - openrouter-claude : OpenRouter Claude 3.5 Sonnet
#   - llama             : OpenRouter Meta Llama 3.3 70B
# -----------------------------------------------------------------------------
AGENT_PROFILE=sonnet

# -----------------------------------------------------------------------------
# 3. Manual Provider & Model Overrides
# -----------------------------------------------------------------------------
# These take effect if AGENT_PROFILE is not set or if you wish to override a preset.
# AGENT_PROVIDER=anthropic                     # Options: anthropic | openai | nvidia | openrouter
# AGENT_MODEL_NAME=claude-sonnet-4-20250514    # Exact model identifier string
# AGENT_MAX_TOKENS=8192                        # Max output tokens generated per LLM response

# -----------------------------------------------------------------------------
# 4. Provider Failover & Circuit Breaker
# -----------------------------------------------------------------------------
# Automatically route requests to a secondary fallback provider if the primary
# provider returns HTTP 429 (rate limit), 500, 502, 503, 504, or 529 (overloaded).
# -----------------------------------------------------------------------------
AGENT_ENABLE_FAILOVER=false
# AGENT_FALLBACK_PROVIDER=openrouter           # Fallback provider: openrouter | openai | nvidia | anthropic
# AGENT_FALLBACK_MODEL=deepseek/deepseek-chat  # Model identifier for the fallback provider

# -----------------------------------------------------------------------------
# 5. Agent Execution & Policy Settings
# -----------------------------------------------------------------------------
# Permission Mode:
#   - safe      : Explicitly safe commands auto-approved; all others prompt user
#   - auto-test : Auto-approves test runners (pytest, npm test, etc.); prompts for others
#   - yolo      : Auto-approves commands except hard safety floors (blocked patterns & secret files)
AGENT_PERMISSION_MODE=safe

# Execution Mode:
#   - react     : Full autonomous ReAct reasoning + tool loop (Default)
#   - fast_path : Agentless 3-phase surgical repair (Localize -> Patch -> Validate)
#   - auto      : Attempts fast-path first; falls back to full ReAct on failure
AGENT_EXECUTION_MODE=react

# Maximum ReAct tool execution turns before halting a single prompt
AGENT_MAX_ITERATIONS=25

# Enable domain guardrail to reject non-software development queries
AGENT_ENABLE_DOMAIN_GUARDRAIL=true

# -----------------------------------------------------------------------------
# 6. Context Window & Token Budget Management
# -----------------------------------------------------------------------------
# AGENT_MAX_CONTEXT_TOKENS=100000              # Total context window budget in tokens
# AGENT_SUMMARIZATION_THRESHOLD=0.75           # Trigger tool-result compaction at 75% budget
# AGENT_MAX_OUTPUT_PER_TOOL=10000              # Truncate tool output if exceeding chars

# -----------------------------------------------------------------------------
# 7. Sandboxing & Command Execution Isolation
# -----------------------------------------------------------------------------
# Sandbox Mode:
#   - local    : Restricted host execution (scrubbed env vars, timeout kill-tree, CWD jail)
#   - docker   : Fully isolated Docker Linux container (hardened filesystem & network control)
#   - disabled : Unrestricted host execution (no env scrubbing; use with extreme caution)
AGENT_SANDBOX_MODE=local

# Docker image used when AGENT_SANDBOX_MODE=docker
AGENT_SANDBOX_DOCKER_IMAGE=python:3.12-slim

# Ephemeral Workspace:
#   - When true, commands run in a temporary disposable copy of your project.
#   - Untrusted scripts cannot delete or mutate original host files.
AGENT_SANDBOX_EPHEMERAL=false

# Outbound Network Control:
#   - When false, blocks outbound traffic (--network none in Docker, blocks curl/wget on host).
#   - Protects against malicious scripts exfiltrating data or API keys to external servers.
AGENT_SANDBOX_ALLOW_NETWORK=true

# Command timeout in seconds before terminating process tree
AGENT_TIMEOUT=120

# -----------------------------------------------------------------------------
# 8. Custom Base URLs & Local LLM Endpoints
# -----------------------------------------------------------------------------
# Override default endpoints for local LLM servers (Ollama, vLLM, LM Studio, LiteLLM)
# or custom enterprise proxy gateways.
# -----------------------------------------------------------------------------
# AGENT_BASE_URL=http://localhost:11434/v1     # General override for any OpenAI-compatible server
# AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
