# LLM Provider API Keys
# Only one provider needs to be configured at a time.

# --- Anthropic (Claude models) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- NVIDIA NIM (OpenAI-compatible, recommended for local dev) ---
# Get your key at: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...

# --- OpenAI ---
# OPENAI_API_KEY=sk-...

# =============================================================================
# Model Configuration
# Set AGENT_PROVIDER to the provider you have a key for.
# =============================================================================

# NVIDIA NIM example (nemotron-3-ultra):
# AGENT_PROVIDER=nvidia
# AGENT_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
# AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AGENT_MAX_TOKENS=15000

# Anthropic example (claude sonnet):
# AGENT_PROVIDER=anthropic
# AGENT_MODEL_NAME=claude-sonnet-4-20250514
# AGENT_MAX_TOKENS=8192

# OpenAI example:
# AGENT_PROVIDER=openai
# AGENT_MODEL_NAME=gpt-4o
# AGENT_MAX_TOKENS=8192

# =============================================================================
# Agent Configuration
# =============================================================================
# AGENT_MAX_ITERATIONS=25
# AGENT_PERMISSION_MODE=safe          # safe | auto-test | yolo

# =============================================================================
# Context Configuration
# =============================================================================
# AGENT_MAX_CONTEXT_TOKENS=100000
